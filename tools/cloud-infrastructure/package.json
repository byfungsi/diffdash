{
  "name": "@diffdash/cloud-infrastructure",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {},
  "scripts": {
    "build": "tsc --noEmit",
    "build:cloud": "node build-cloud.mjs",
    "deploy": "ALCHEMY_PROFILE=${ALCHEMY_PROFILE:-ocha-poc-token-admin} alchemy deploy alchemy.run.ts --stage prod",
    "deploy:dry-run": "ALCHEMY_PROFILE=${ALCHEMY_PROFILE:-ocha-poc-token-admin} alchemy plan alchemy.run.ts --stage prod",
    "dev": "ALCHEMY_PROFILE=${ALCHEMY_PROFILE:-ocha-poc-token-admin} alchemy dev alchemy.run.ts --stage dev",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "test": "node --test build-cloud.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.72",
    "@effect/platform-node": "catalog:cloud-infrastructure",
    "@types/node": "catalog:",
    "alchemy": "catalog:cloud-infrastructure",
    "effect": "catalog:cloud-infrastructure",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:cloud-infrastructure"
  }
}
