{
  "name": "@diffdash/desktop",
  "private": true,
  "productName": "DiffDash",
  "version": "0.12.0",
  "description": "Desktop code review app with Effect-powered TypeScript services.",
  "homepage": "https://github.com/byfungsi/diffdash",
  "author": "Muhammad Hanif",
  "license": "ISC",
  "type": "module",
  "main": "out/main/index.js",
  "exports": {},
  "bin": {
    "diffdash": "bin/diffdash.mjs"
  },
  "scripts": {
    "assets:icons": "node scripts/generate-icons.mjs",
    "dev": "node scripts/close-dev-instance.mjs && pnpm assets:icons && pnpm build:core-artifact && electron-vite dev",
    "build": "pnpm build:core-artifact && electron-vite build",
    "build:e2e": "pnpm build:core-artifact:e2e && electron-vite build --mode e2e",
    "build:core-artifact": "node scripts/build-core-artifact.mjs",
    "build:core-artifact:e2e": "node scripts/build-core-artifact.mjs --mode=e2e",
    "pack": "pnpm assets:icons && pnpm build && electron-builder --dir --publish=never",
    "dist": "pnpm assets:icons && pnpm build && electron-builder --publish=never",
    "dist:mac": "pnpm assets:icons && pnpm build && electron-builder --mac dmg zip --publish=never",
    "dist:linux": "pnpm assets:icons && pnpm build && electron-builder --linux AppImage deb --publish=never",
    "dist:linux:deb": "pnpm assets:icons && pnpm build && electron-builder --linux deb --publish=never",
    "dist:win": "pnpm assets:icons && pnpm build && electron-builder --win nsis --publish=never",
    "fixtures:database-v8": "pnpm --filter @diffdash/persistence fixtures:database-v8",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run && node --test scripts/build-core-artifact.test.mjs scripts/core-utility-process-launcher.electron.test.mjs",
    "test:watch": "vitest",
    "lint": "oxlint electron src scripts --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@diffdash/app": "workspace:*",
    "@diffdash/core": "workspace:*",
    "@diffdash/core-rpc": "workspace:*",
    "@diffdash/domain": "workspace:*",
    "@diffdash/protocol": "workspace:*",
    "@diffdash/process": "workspace:*",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "electron-updater": "6.8.9",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.28.1",
    "oxlint": "catalog:",
    "tailwindcss": "^4.3.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "build": {
    "appId": "dev.diffdash.app",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "compression": "normal",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/**/*.node"
    ],
    "extraResources": [
      {
        "from": ".generated/core",
        "to": "core"
      }
    ],
    "removePackageScripts": true,
    "publish": [
      {
        "provider": "generic",
        "url": "https://download.usediffdash.com/updates/stable"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "icon": "resources/icons/icon.icns",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ],
      "type": "distribution",
      "extraResources": [
        {
          "from": "resources/darwin/bin/diffdash",
          "to": "bin/diffdash"
        }
      ]
    },
    "dmg": {
      "backgroundColor": "#111827",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "category": "Development",
      "executableName": "diffdash-desktop",
      "icon": "resources/icons/png",
      "target": [
        "AppImage",
        "deb"
      ],
      "extraResources": [
        {
          "from": "resources/linux/bin/diffdash",
          "to": "bin/diffdash"
        }
      ]
    },
    "deb": {
      "maintainer": "Muhammad Hanif <pocisite@gmail.com>",
      "afterInstall": "resources/linux/deb/after-install.sh",
      "afterRemove": "resources/linux/deb/after-remove.sh"
    },
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "perMachine": false
    }
  }
}
