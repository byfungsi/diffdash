#!/bin/sh
set -eu

usage() {
  printf '%s\n' \
    'Usage: diffdash [path]' \
    '       diffdash install [path]' \
    '       diffdash pr [pr-number]' \
    '       diffdash diff [branch-name]' \
    '       diffdash last-commit | lc' \
    '       diffdash compare <base> <head> [--repository=<repository>]' \
    '       diffdash repair'
}

for argument in "$@"; do
  case "$argument" in
    -h|--help)
      usage
      exit 0
      ;;
  esac
done

self_path="$0"
if command -v readlink >/dev/null 2>&1; then
  resolved_path="$(readlink "$0" 2>/dev/null || true)"
  if [ -n "$resolved_path" ]; then
    case "$resolved_path" in
      /*) self_path="$resolved_path" ;;
      *) self_path="$(dirname "$0")/$resolved_path" ;;
    esac
  fi
fi

contents_dir="$(dirname "$(dirname "$(dirname "$self_path")")")"
app_binary="$contents_dir/MacOS/DiffDash"

if [ ! -x "$app_binary" ]; then
  app_binary='/Applications/DiffDash.app/Contents/MacOS/DiffDash'
fi

if [ ! -x "$app_binary" ]; then
  printf '%s\n' 'Could not find the installed DiffDash app binary.' >&2
  exit 1
fi

ready_dir="$(mktemp -d "${TMPDIR:-/tmp}/diffdash-cli.XXXXXX")"
ready_path="$ready_dir/ready"
trap 'rm -rf "$ready_dir"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

app_bundle="$(dirname "$(dirname "$(dirname "$app_binary")")")"
open -n -a "$app_bundle" --args "--diffdash-cli-v1=$PWD" "--diffdash-cli-ready-v1=$ready_path" -- "$@" >/dev/null 2>&1

attempt=0
while [ ! -f "$ready_path" ]; do
  if [ "$attempt" -ge 600 ]; then
    printf '%s\n' 'Timed out waiting for DiffDash to finish opening.' >&2
    exit 1
  fi
  attempt=$((attempt + 1))
  sleep 0.05
done
