# Proposed Cloud auth configuration. Names only: never place real values in this file.
# The OAuth/App Worker bindings are not implemented yet.
# Use ignored local files; deploy server secrets through secret bindings, never VITE_*.

# DiffDash-owned configuration (production origin from alchemy.run.ts).
APPLICATION_ORIGIN=https://diffshub.com
BETTER_AUTH_SECRET=
GITHUB_USER_TOKEN_ENCRYPTION_KEY=
GITHUB_USER_TOKEN_ENCRYPTION_KEY_VERSION=1
GITHUB_AUTHORIZATION_ATTEMPT_LIFETIME_SECONDS=600

# Reuse Fungsi's existing OAuth registration for login.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# New dedicated DiffDash GitHub App for repository authorization.
# Populate these credentials from the new App; do not copy Fungsi's GITHUB_APP_* values.
# Register setup URL: https://diffshub.com/api/github/setup/callback
# Register webhook URL: https://diffshub.com/api/github/webhooks
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_USER_AUTHORIZATION_CALLBACK_URL=https://diffshub.com/api/github/user-authorization/callback

# Deployment-only credentials: keep in a separate ignored .env.deploy.local file.
# Do not bind these to the application Worker or expose them to the browser.
# Supply only the authentication method supported by DiffDash's pinned Alchemy version.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_EMAIL=
# ALCHEMY_PASSWORD=
